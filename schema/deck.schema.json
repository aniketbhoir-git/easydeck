{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easydeck.dev/schema/deck.schema.json",
  "title": "EasyDeck deck",
  "description": "First draft (R0). A deck is pages of widgets; widgets run actions and read sources. An LLM edits this file only, never app code.",
  "type": "object",
  "required": ["version", "name", "pages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "description": "Deck format version." },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "settings": { "$ref": "#/$defs/settings" },
    "sources": {
      "type": "object",
      "description": "Named data feeds. Keys are source ids that widgets reference.",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homePage": { "$ref": "#/$defs/id", "description": "Page id shown at start and after a context page closes." },
        "theme": { "enum": ["dark", "light"], "default": "dark" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "title", "grid", "widgets"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "grid": {
          "type": "object",
          "required": ["columns", "rows"],
          "additionalProperties": false,
          "properties": {
            "columns": { "type": "integer", "minimum": 1, "maximum": 24 },
            "rows": { "type": "integer", "minimum": 1, "maximum": 24 }
          }
        },
        "trigger": { "$ref": "#/$defs/trigger" },
        "widgets": {
          "type": "array",
          "items": { "$ref": "#/$defs/widget" }
        }
      }
    },
    "trigger": {
      "type": "object",
      "description": "Context rule. The page opens when the rule becomes true and the deck returns when it becomes false.",
      "required": ["source", "when"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/id", "description": "Id of a game_watch source." },
        "when": {
          "type": "object",
          "required": ["process"],
          "additionalProperties": false,
          "properties": {
            "process": { "type": "string", "minLength": 1, "description": "Process name, for example game.exe." }
          }
        }
      }
    },
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1, "default": 1 },
        "h": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "widgetBase": {
      "type": "object",
      "required": ["id", "type", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "label": { "type": "string", "maxLength": 60 },
        "icon": { "type": "string", "description": "Path inside the pack (icons/...) or an https URL." },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "widget": {
      "oneOf": [
        { "$ref": "#/$defs/widgetLaunch" },
        { "$ref": "#/$defs/widgetMacro" },
        { "$ref": "#/$defs/widgetToggle" },
        { "$ref": "#/$defs/widgetGauge" },
        { "$ref": "#/$defs/widgetStatus" },
        { "$ref": "#/$defs/widgetText" },
        { "$ref": "#/$defs/widgetMedia" },
        { "$ref": "#/$defs/widgetEmbed" }
      ]
    },
    "widgetLaunch": {
      "allOf": [{ "$ref": "#/$defs/widgetBase" }],
      "type": "object",
      "required": ["type", "action"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "launch" },
        "action": { "$ref": "#/$defs/actionLaunch" },
        "order": { "enum": ["fixed", "recent"], "default": "fixed", "description": "recent sorts by local play history at render time." },
        "id": {}, "label": {}, "icon": {}, "position": {}
      }
    },
    "widgetMacro": {
      "allOf": [{ "$ref": "#/$defs/widgetBase" }],
      "type": "object",
      "required": ["type", "action"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "macro" },
        "action": { "$ref": "#/$defs/actionKeyMacro" },
        "id": {}, "label": {}, "icon": {}, "position": {}
      }
    },
    "widgetToggle": {
      "allOf": [{ "$ref": "#/$defs/widgetBase" }],
      "type": "object",
      "required": ["type", "onAction"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "toggle" },
        "onAction": { "$ref": "#/$defs/action" },
        "offAction": { "$ref": "#/$defs/action" },
        "id": {}, "label": {}, "icon": {}, "position": {}
      }
    },
    "widgetGauge": {
      "allOf": [{ "$ref": "#/$defs/widgetBase" }],
      "type": "object",
      "required": ["type", "source", "metric"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "gauge" },
        "source": { "$ref": "#/$defs/id" },
        "metric": { "type": "string", "description": "Field of the source value, for example cpu.load or gpu.temp." },
        "min": { "type": "number", "default": 0 },
        "max": { "type": "number", "default": 100 },
        "unit": { "type": "string", "maxLength": 8 },
        "id": {}, "label": {}, "icon": {}, "position": {}
      }
    },
    "widgetStatus": {
      "allOf": [{ "$ref": "#/$defs/widgetBase" }],
      "type": "object",
      "required": ["type", "source"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "status" },
        "source": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "description": "JSON path into the source value." },
        "okWhen": { "type": "string", "description": "Value that counts as OK. Anything else shows as a problem." },
        "id": {}, "label": {}, "icon": {}, "position": {}
      }
    },
    "widgetText": {
      "allOf": [{ "$ref": "#/$defs/widgetBase" }],
      "type": "object",
      "required": ["type"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "text" },
        "kind": { "enum": ["label", "clock", "date"], "default": "label" },
        "text": { "type": "string", "maxLength": 200 },
        "format": { "type": "string", "maxLength": 40, "description": "Clock or date format pattern." },
        "id": {}, "label": {}, "icon": {}, "position": {}
      }
    },
    "widgetMedia": {
      "allOf": [{ "$ref": "#/$defs/widgetBase" }],
      "type": "object",
      "required": ["type", "provider"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "media" },
        "provider": { "const": "spotify" },
        "controls": {
          "type": "array",
          "items": { "enum": ["play_pause", "next", "previous", "volume"] },
          "uniqueItems": true
        },
        "id": {}, "label": {}, "icon": {}, "position": {}
      }
    },
    "widgetEmbed": {
      "allOf": [{ "$ref": "#/$defs/widgetBase" }],
      "type": "object",
      "required": ["type", "url"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "embed" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "refreshSeconds": { "type": "integer", "minimum": 0 },
        "id": {}, "label": {}, "icon": {}, "position": {}
      }
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/actionLaunch" },
        { "$ref": "#/$defs/actionKeyMacro" },
        { "$ref": "#/$defs/actionShell" },
        { "$ref": "#/$defs/actionPage" }
      ]
    },
    "actionLaunch": {
      "type": "object",
      "required": ["type", "kind"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "launch" },
        "kind": { "enum": ["steam", "exe", "uri", "url"] },
        "appId": { "type": "integer", "minimum": 1, "description": "Steam app id (kind steam)." },
        "path": { "type": "string", "description": "Program path (kind exe)." },
        "args": { "type": "array", "items": { "type": "string" } },
        "fallback": { "type": "string", "description": "Path or URI to try when path is missing (kind exe)." },
        "target": { "type": "string", "description": "URI or URL (kinds uri and url)." }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "steam" } } }, "then": { "required": ["appId"] } },
        { "if": { "properties": { "kind": { "const": "exe" } } }, "then": { "required": ["path"] } },
        { "if": { "properties": { "kind": { "enum": ["uri", "url"] } } }, "then": { "required": ["target"] } }
      ]
    },
    "actionKeyMacro": {
      "type": "object",
      "required": ["type", "keys"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "key_macro" },
        "keys": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Key names pressed in order, for example [\"1\", \"2\", \"ctrl+q\"]." },
        "cycleMs": { "type": "integer", "minimum": 0, "description": "Repeat period in ms. 0 or absent runs the sequence once." },
        "keyGapMs": { "type": "integer", "minimum": 0, "default": 50 },
        "holdMs": { "type": "integer", "minimum": 0, "default": 30 },
        "toggle": { "type": "boolean", "default": false, "description": "When true, a tap starts the loop and the next tap stops it." }
      }
    },
    "actionShell": {
      "type": "object",
      "required": ["type", "command"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "shell" },
        "command": { "$ref": "#/$defs/id", "description": "Allow-list id from the app settings. Never a raw command line." },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actionPage": {
      "type": "object",
      "required": ["type", "page"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "page" },
        "page": { "$ref": "#/$defs/id" }
      }
    },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/sourceSystemStats" },
        { "$ref": "#/$defs/sourceHttpPoll" },
        { "$ref": "#/$defs/sourceGameWatch" }
      ]
    },
    "sourceSystemStats": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "system_stats" },
        "intervalMs": { "type": "integer", "minimum": 250, "default": 1000 },
        "metrics": {
          "type": "array",
          "items": { "enum": ["cpu.load", "cpu.temp", "gpu.load", "gpu.temp", "ram.used", "ram.total"] },
          "uniqueItems": true
        }
      }
    },
    "sourceHttpPoll": {
      "type": "object",
      "required": ["kind", "url"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "http_poll" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "intervalSeconds": { "type": "integer", "minimum": 5, "default": 60 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60, "default": 10 }
      }
    },
    "sourceGameWatch": {
      "type": "object",
      "required": ["kind", "processes"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "game_watch" },
        "processes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "intervalMs": { "type": "integer", "minimum": 500, "default": 2000 }
      }
    }
  }
}
