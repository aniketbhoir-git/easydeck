{
  "version": 1,
  "name": "Timer deck",
  "settings": {
    "homePage": "home"
  },
  "pages": [
    {
      "id": "home",
      "title": "Home",
      "grid": {
        "columns": 4,
        "rows": 2
      },
      "widgets": [
        {
          "id": "brew",
          "type": "timer",
          "label": "Brew",
          "mode": "countdown",
          "durationS": 300,
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "lap",
          "type": "timer",
          "label": "Lap",
          "mode": "stopwatch",
          "position": {
            "x": 1,
            "y": 0
          }
        }
      ]
    }
  ]
}
